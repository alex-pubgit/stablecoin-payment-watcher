# Secrets for the notifiers you switch on in paywatch.toml. Copy to .env, never commit it.

# Telegram bot token from @BotFather (notify.telegram_chat_id)
PAYWATCH_TELEGRAM_TOKEN=

# Discord channel webhook URL (notify.discord)
PAYWATCH_DISCORD_WEBHOOK=

# Shared secret for signing your own webhook (notify.webhook_url)
PAYWATCH_WEBHOOK_SECRET=
